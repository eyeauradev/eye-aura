rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDoctorOrAdmin() {
      return isDoctor() || isAdmin();
    }

    function isFutureDate(date) {
      return date > request.time;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Create: Only allow creating user with role "patient" to prevent role escalation
      allow create: if signedIn() 
        && request.auth.uid == userId
        && request.resource.data.role == "patient";
      
      // Update: Only admins can change roles, owners can update other fields
      allow update: if isOwner(userId) 
        && !request.resource.diff(resource.data).affectedKeys().hasAny(['role'])
        || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Services Collection (Public read, Admin write)
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow read: if isOwner(resource.data.patientId) 
        || isOwner(resource.data.doctorId)
        || isAdmin();
      
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && isFutureDate(request.resource.data.scheduledFor);
      
      allow update: if isOwner(resource.data.patientId)
        || isOwner(resource.data.doctorId)
        || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Doctor Slots Collection
    match /doctor_slots/{slotId} {
      allow read: if true;
      
      allow create: if isDoctorOrAdmin()
        && request.resource.data.doctorId == request.auth.uid
        && isFutureDate(request.resource.data.startTime);
      
      allow update: if isOwner(resource.data.doctorId) || isAdmin();
      allow delete: if isOwner(resource.data.doctorId) || isAdmin();
    }

    // Prescriptions Collection
    match /prescriptions/{prescriptionId} {
      allow read: if isOwner(resource.data.patientId)
        || isOwner(resource.data.doctorId)
        || isAdmin();
      
      allow create: if isDoctorOrAdmin()
        && request.resource.data.doctorId == request.auth.uid;
      
      allow update: if isOwner(resource.data.doctorId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.patientId)
        || isOwner(resource.data.doctorId)
        || isAdmin();
      
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Doctor Invites Collection - Admin only
    match /doctor_invites/{inviteId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
