# Server-side only — DO NOT add NEXT_PUBLIC_ prefix (would expose key to browser)
RESEND_API_KEY=

# Razorpay — NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose (public key only)
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET must NEVER be exposed to the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
