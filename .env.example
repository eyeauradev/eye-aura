NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Analytics Measurement ID — same value as your GA4 Measurement ID in most setups
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-side only — DO NOT add NEXT_PUBLIC_ prefix (would expose key to browser)
RESEND_API_KEY=

# Razorpay — NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose (public key only)
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET must NEVER be exposed to the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — copy from Razorpay Dashboard → Webhooks → your webhook → Secret
# Used to verify that incoming webhook requests genuinely come from Razorpay
RAZORPAY_WEBHOOK_SECRET=R9q6VGiZUSnsR@S

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX) — required for GA4 script injection via @next/third-parties
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
